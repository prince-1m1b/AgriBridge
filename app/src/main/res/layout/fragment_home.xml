<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_green"
    tools:context=".ui.dashboard.fragments.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Categories -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_category" />

            <!-- Banner -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_banner" />

            <!-- Government Schemes Header -->

            <LinearLayout
                android:id="@+id/sectionSchemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <RelativeLayout
                    android:id="@+id/layoutSchemesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvSchemeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/government_schemes"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSchemeViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_bg_rounded_white_15_dp"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="5dp"
                        android:text="@string/view_all"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Government Schemes List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSchemes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_scheme" />

                <TextView
                    android:id="@+id/tvEmptySchemes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_bg_rounded_white_15_dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_schemes_available"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Loans Header -->

            <LinearLayout
                android:id="@+id/sectionLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />


                <RelativeLayout
                    android:id="@+id/layoutLoansHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvLoanTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loans"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLoanViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_bg_rounded_white_15_dp"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="5dp"
                        android:text="@string/view_all"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Loans List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLoans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_loan" />

                <TextView
                    android:id="@+id/tvEmptyLoans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_bg_rounded_white_15_dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_loans_available"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Market Place Header -->

            <LinearLayout
                android:id="@+id/sectionMarket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />


                <RelativeLayout
                    android:id="@+id/layoutMarketHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvMarketTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_place"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMarketViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_bg_rounded_white_15_dp"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="5dp"
                        android:text="View All"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Market Place List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMarketPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_market_card" />

                <TextView
                    android:id="@+id/tvEmptyMarketPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_bg_rounded_white_15_dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_markets_available"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Bottom Space -->

            <LinearLayout
                android:id="@+id/sectionSubsidy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />


                <RelativeLayout
                    android:id="@+id/layoutSubsidyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvSubsidyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subsidies"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAllSubsidyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/ic_bg_rounded_white_15_dp"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="5dp"
                        android:text="@string/view_all"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold" />

                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSubsidies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_subsidy" />

                <TextView
                    android:id="@+id/tvEmptySubsidies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_bg_rounded_white_15_dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_subsidies_available"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Credit text -->
            <TextView
                android:id="@+id/tvDeveloperCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Concept and Design by Rayan Upadhyay"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="italic" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Custom Animated Agricultural Loader -->
    <LinearLayout
        android:id="@+id/layoutCustomLoader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_green"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Outer Elevated Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_custom_loader_card"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="36dp">

            <!-- Logo / Icon Container with Pulsing Rings -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <!-- Animated Outer Pulse Ring -->
                <View
                    android:id="@+id/viewLoaderPulseRing"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_loader_pulse_ring" />

                <!-- Inner Icon Container Circle -->
                <FrameLayout
                    android:id="@+id/layoutLoaderIconCircle"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_loader_icon_circle">

                    <ImageView
                        android:id="@+id/ivLoaderLogo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_loader_schemes" />

                </FrameLayout>

            </FrameLayout>

            <!-- Dynamic Category Title -->
            <TextView
                android:id="@+id/tvLoaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/loader_title_schemes"
                android:textColor="@color/green_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Dynamic Subtitle -->
            <TextView
                android:id="@+id/tvLoaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/loader_subtitle_schemes"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Indeterminate Progress Indicator -->
            <ProgressBar
                android:id="@+id/loaderProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="160dp"
                android:layout_height="4dp"
                android:layout_marginTop="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/green_primary" />

            <!-- Animated Stage Indicator Dots -->
            <LinearLayout
                android:id="@+id/layoutLoaderDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot0"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/green_primary" />

                <View
                    android:id="@+id/dot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/light_gray" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/light_gray" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/light_gray" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/shape_dot"
                    android:backgroundTint="@color/light_gray" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
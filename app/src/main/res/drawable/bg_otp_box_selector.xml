<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: highlighted with green stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="10dp" />
            <stroke android:width="1.8dp" android:color="@color/green_primary" />
        </shape>
    </item>
    <!-- Default state: soft gray outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F9FAFB" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#D1D5DB" />
        </shape>
    </item>
</selector>
